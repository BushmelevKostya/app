# ========================================
# APPLICATION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in the actual values
# Never commit .env to version control!

# ========================================
# SERVER CONFIGURATION
# ========================================

# Server port for the application
# Default: 2580
SERVER_PORT=2580

# Active Spring profile (dev, test, prod)
# Default: dev
SPRING_PROFILES_ACTIVE=dev

# ========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================

# PostgreSQL database URL
# Format: jdbc:postgresql://<host>:<port>/<database>
# Development: jdbc:postgresql://localhost:5434/is
# Docker: jdbc:postgresql://postgres:5432/is
DB_URL=jdbc:postgresql://localhost:5434/is

# Database username
DB_USER=is

# Database password
# IMPORTANT: Change this in production!
DB_PASSWORD=is

# Hibernate DDL auto mode (create, create-drop, update, validate, none)
# Development: update (auto-update schema)
# Production: validate or none (use migrations instead)
# Default: update
HIBERNATE_DDL_AUTO=update

# Show SQL queries in logs (true/false)
# Development: true
# Production: false
# Default: true
HIBERNATE_SHOW_SQL=true

# ========================================
# REDIS CONFIGURATION
# ========================================

# Redis host
# Development: localhost
# Docker: redis
REDIS_HOST=localhost

# Redis port
# Default: 6379
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis connection timeout in milliseconds
# Default: 2000
REDIS_TIMEOUT=2000

# Redis connection pool settings
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# ========================================
# MINIO CONFIGURATION (Object Storage)
# ========================================

# MinIO endpoint URL
# Development: http://127.0.0.1:9000
# Docker: http://minio:9000
MINIO_ENDPOINT=http://127.0.0.1:9000

# MinIO access key (username)
# Default: minioadmin
MINIO_ACCESS_KEY=minioadmin

# MinIO secret key (password)
# IMPORTANT: Change this in production!
# Default: minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket name for storing files
# Default: movies
MINIO_BUCKET_NAME=movies

# ========================================
# JWT CONFIGURATION (Authentication)
# ========================================

# JWT secret key for signing tokens
# IMPORTANT: Generate a strong random key for production!
# Minimum 256 bits (32 characters) recommended
# You can generate one with: openssl rand -hex 32
# Default: 404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT token expiration time in milliseconds
# 86400000 ms = 24 hours
# 3600000 ms = 1 hour
# Default: 86400000 (24 hours)
JWT_EXPIRATION=86400000

# ========================================
# CORS CONFIGURATION
# ========================================

# Allowed origins for CORS (comma-separated for multiple origins)
# Development: http://localhost:4200
# Production: https://yourdomain.com,https://www.yourdomain.com
# Default: http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================

# Enable/disable multipart file upload
# Default: true
MULTIPART_ENABLED=true

# Maximum file size for uploads
# Examples: 10MB, 50MB, 100MB
# Default: 10MB
MULTIPART_MAX_FILE_SIZE=10MB

# Maximum request size (including all files)
# Default: 10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log level for application code
# Values: TRACE, DEBUG, INFO, WARN, ERROR
# Development: DEBUG
# Production: INFO or WARN
# Default: DEBUG
LOG_LEVEL_APP=DEBUG

# Log level for Spring Security
# Values: TRACE, DEBUG, INFO, WARN, ERROR
# Default: DEBUG
LOG_LEVEL_SECURITY=DEBUG

# Log level for Hibernate
# Default: INFO
LOG_LEVEL_HIBERNATE=INFO

# ========================================
# ACTUATOR CONFIGURATION (Health Checks)
# ========================================

# Expose actuator endpoints
# Default: health,info
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Show detailed health information
# Values: never, when-authorized, always
# Development: always
# Production: when-authorized
# Default: always
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ========================================
# DOCKER-SPECIFIC VARIABLES
# ========================================
# These variables are used when running with docker-compose
# They override the defaults above

# Use these when running in Docker:
# DB_URL=jdbc:postgresql://postgres:5432/is
# REDIS_HOST=redis
# MINIO_ENDPOINT=http://minio:9000

# ========================================
# PRODUCTION SECURITY CHECKLIST
# ========================================
# Before deploying to production, ensure:
# 
# [ ] Change DB_PASSWORD to a strong password
# [ ] Generate a new JWT_SECRET (at least 256 bits)
# [ ] Change MINIO_ACCESS_KEY and MINIO_SECRET_KEY
# [ ] Set HIBERNATE_DDL_AUTO=validate or none
# [ ] Set HIBERNATE_SHOW_SQL=false
# [ ] Set LOG_LEVEL_APP=INFO or WARN
# [ ] Set LOG_LEVEL_SECURITY=WARN or ERROR
# [ ] Update CORS_ALLOWED_ORIGINS to your production domain
# [ ] Set MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
# [ ] Never commit .env file to version control
# [ ] Use secrets management in production (AWS Secrets Manager, HashiCorp Vault, etc.)
